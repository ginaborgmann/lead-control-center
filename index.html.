function renderLeads(){const search=document.getElementById('lead-search').value.toLowerCase(),assigned=document.getElementById('lead-filter').value==='assigned';const open=db.leads.filter(l=>!l.partnerId),done=db.leads.filter(l=>l.partnerId&&l.assignedAt).sort((a,b)=>new Date(b.assignedAt)-new Date(a.assignedAt));document.getElementById('open-lead-count').textContent=`(${open.length})`;document.getElementById('assigned-lead-count').textContent=`(${done.length})`;document.getElementById('tab-open').classList.toggle('active',!assigned);document.getElementById('tab-assigned').classList.toggle('active',assigned);document.getElementById('assigned-retention-note').style.display=assigned?'block':'none';const leads=(assigned?done:open).filter(l=>l.name.toLowerCase().includes(search)||l.zip.includes(search)||l.source.toLowerCase().includes(search)||(assigned&&(partner(l.partnerId)?.name||'').toLowerCase().includes(search)));document.getElementById('leads-head').innerHTML=assigned?'<tr><th>Lead</th><th>PLZ</th><th>Leadanbieter / Quelle</th><th>Zugewiesen an</th><th>Datum</th></tr>':'<tr><th>Lead</th><th>PLZ · Vorschläge</th><th>Leadanbieter / Quelle</th><th>Aktion</th></tr>';document.getElementById('leads-body').innerHTML=leads.map(l=>assigned?`<tr><td><strong>${escapeHTML(l.name)}</strong></td><td>${escapeHTML(l.zip)}</td><td>${escapeHTML(l.source)}</td><td>${escapeHTML(partner(l.partnerId)?.name||'Unbekannter Partner')}</td><td>${new Date(l.assignedAt).toLocaleString('de-DE')}</td></tr>`:`<tr><td><strong>${escapeHTML(l.name)}</strong></td><td>${zipButton(l)}</td><td>${escapeHTML(l.source)}</td><td><button class="btn secondary" onclick="showSuggestions(${l.id})">10 Vorschläge ansehen</button></td></tr>`).join('')||`<tr><td colspan="${assigned?5:4}" class="empty">${assigned?'Noch keine zugewiesenen Leads in den letzten 12 Wochen':'Keine offenen Leads gefunden'}</td></tr>`;if(leadMode==='focus')renderFocusLead()}
let routeRequest=0;
async function routeFromTo(l,p){const point=zipCoordinates[l.zip];if(!point||!Number.isFinite(p.lat)||!Number.isFinite(p.lon))return null;try{const u=`https://router.project-osrm.org/route/v1/driving/${point[1]},${point[0]};${p.lon},${p.lat}?overview=false`;const controller=new AbortController();const timeout=setTimeout(()=>controller.abort(),9000);try{const response=await fetch(u,{signal:controller.signal});if(!response.ok)return null;const data=await response.json();const r=data.routes?.[0];return r?{km:r.distance/1000,min:Math.ceil(r.duration/60)}:null}finally{clearTimeout(timeout)}}catch{return null}}
async function manualPartnerChoice(){const id=Number(document.getElementById('manual-partner-select').value),l=db.leads.find(x=>x.id===activeLeadId),p=partner(id);const out=document.getElementById('manual-partner-route');document.getElementById('manual-assign-button').disabled=!p;if(!l||!p){out.textContent='';return}out.textContent='Fahrstrecke wird berechnet …';const route=await routeFromTo(l,p);if(activeLeadId!==l.id||Number(document.getElementById('manual-partner-select').value)!==id)return;out.textContent=route?`${route.km.toFixed(1).replace('.',',')} km · ${route.min} Min. Fahrtzeit`:'Fahrstrecke derzeit nicht verfügbar'}
