function toast(s){const el=document.getElementById('toast');el.textContent=s;el.style.display='block';clearTimeout(window.toastTimer);window.toastTimer=setTimeout(()=>el.style.display='none',3500)};const pages={dashboard:['G.B LEAD CONTROL CENTER','Alles bis zur Zuweisung – auf einen Blick.'],leads:['Offene Leads','Lead auswählen, Vorschläge ansehen und direkt zuweisen.'],orders:['Bestellungen','Wöchentliche Kontingente starten montags neu; Einmalbestellungen laufen bis zur Erfüllung.'],'partner-map':['Vertrieblerkarte','Alle Vertriebspartner auf einer Karte mit Standort-PLZ.'],partners:['Vertriebspartner','Partner und Reonic-Zuordnung verwalten.'],history:['Bestellhistorie','Bestell-E-Mails und Versanddokumentation.'],settings:['Einstellungen','Verbindungen und Demo-Einstellungen.']};function navigate(page){document.querySelectorAll('.view').forEach(e=>e.classList.toggle('active',e.id===page));document.querySelectorAll('#nav button').forEach(e=>e.classList.toggle('active',e.dataset.view===page));document.getElementById('page-title').textContent=pages[page][0];document.getElementById('page-subtitle').textContent=pages[page][1];if(page==='partner-map')setTimeout(renderPartnerMap,50)};document.querySelectorAll('#nav button').forEach(b=>b.addEventListener('click',()=>navigate(b.dataset.view)));
const zipCoordinates={'30159':[52.3759,9.7320],'30853':[52.447,9.737],'32052':[52.115,8.672],'34117':[51.3127,9.4797],'31134':[52.1548,9.9579],'33098':[51.7189,8.7575]};let activeLeadId=null;
function haversine(a,b,c,d){const rad=Math.PI/180,dl=(c-a)*rad,do_=(d-b)*rad,h=Math.sin(dl/2)**2+Math.cos(a*rad)*Math.cos(c*rad)*Math.sin(do_/2)**2;return Math.round(6371*2*Math.asin(Math.sqrt(h)))}
function distanceFor(l,p){const point=zipCoordinates[l.zip];return point&&Number.isFinite(p.lat)&&Number.isFinite(p.lon)?haversine(point[0],point[1],p.lat,p.lon):null}
