    const {data:{session},error:sessionError}=await gbClient.auth.getSession();
    if(sessionError||!session)throw new Error('Reset-Link nicht mehr gültig. Bitte einen neuen Passwort-Link anfordern.');
    const {error}=await gbClient.auth.updateUser({password:p});
    if(error)throw error;
    document.getElementById('gb-new-password').value='';
    document.getElementById('gb-new-password-confirm').value='';
    sessionStorage.removeItem('gb-recovery-pending');
    document.getElementById('gb-recovery-box').style.display='none';
    document.getElementById('gb-login-actions').style.display='flex';
    await gbClient.auth.signOut();
    history.replaceState(null,'',location.pathname);
    gbStatus('Passwort gespeichert! Jetzt mit Admin-E-Mail und neuem Passwort sicher anmelden.');
  }catch(e){gbStatus('Passwort konnte nicht gespeichert werden: '+e.message)}
}
function gbAttachRecovery(client){
  client.auth.onAuthStateChange((event)=>{if(event==='PASSWORD_RECOVERY')gbRecoveryShow()});
  if(gbRecoveryLinkPresent()){
    client.auth.getSession().then(({data})=>{if(data?.session)gbRecoveryShow();else gbStatus('Reset-Link wird geprüft. Falls nichts passiert, bitte einen neuen Link anfordern.')});
  }
}

const gbStatus=t=>document.getElementById('gb-status').textContent=t;
function gbShowConnection(){document.getElementById('gb-connect').style.display='flex';document.getElementById('gb-password').value=''}
function gbDemo(){document.getElementById('gb-connect').style.display='none';document.querySelector('.aside-foot').innerHTML='● LOKALE DEMO<br>Ohne Anmeldung · keine Cloud-Speicherung'}
async function gbLogin(){
  const url=document.getElementById('gb-url').value.trim().replace(/\/$/,''),key=document.getElementById('gb-public').value.trim(),email=document.getElementById('gb-email').value.trim(),password=document.getElementById('gb-password').value;
  if(!/^https:\/\/[a-z0-9-]+\.supabase\.co$/i.test(url)){gbStatus('Bitte die vollständige Supabase-Projekt-URL eintragen.');return}
  if(!key||!email||!password){gbStatus('Bitte URL, öffentlichen Schlüssel, E-Mail und Passwort eintragen.');return}
  if(!window.supabase?.createClient){gbStatus('Supabase-Bibliothek nicht geladen. Bitte Internetverbindung prüfen.');return}
  gbStatus('Anmeldung wird geprüft …');
  try{
    gbClient=window.supabase.createClient(url,key,{auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:true}});gbAttachRecovery(gbClient);
    const {data,error}=await gbClient.auth.signInWithPassword({email,password});
    document.getElementById('gb-password').value='';
    if(error)throw error;
    const {data:admin,error:adminError}=await gbClient.from('app_admins').select('user_id').eq('user_id',data.user.id).maybeSingle();
    if(adminError||!admin){await gbClient.auth.signOut();throw new Error('Dieses Konto ist nicht als App-Administrator freigeschaltet. Bitte app_admins/RLS prüfen.')}
    gbSession=data.session;
    localStorage.setItem('gb-supabase-public-config',JSON.stringify({url,key}));
    gbConnected(email);
  }catch(e){gbStatus('Anmeldung fehlgeschlagen: '+e.message)}
}
function gbConnected(email){document.getElementById('gb-connect').style.display='none';document.getElementById('gb-cloud').style.display='block';document.querySelector('.aside-foot').innerHTML='● SUPABASE LOGIN AKTIV<br>Reonic-Abruf bereit · Leads weiterhin lokal';document.getElementById('gb-cloud-status').textContent='Angemeldet als '+email+'. Reonic-Benutzer können jetzt abgerufen werden.';navigate('partners')}
async function gbImport(){
  if(!gbClient){gbShowConnection();return}
  const el=document.getElementById('gb-cloud-status');el.textContent='Reonic-Benutzer werden über Supabase abgerufen …';
  try{
    const {data:sessionData,error:sessionError}=await gbClient.auth.getSession();
    if(sessionError||!sessionData.session)throw new Error('Sitzung abgelaufen. Bitte erneut anmelden.');
    const {data,error}=await gbClient.functions.invoke('reonic-sync-users',{method:'POST',body:{}});
    if(error){let details='';try{details=JSON.stringify(await error.context?.json?.())}catch{}throw new Error(error.message+(details?' – '+details:''))}
    if(!data?.success||!Array.isArray(data.users))throw new Error(data?.error||'Die Funktion hat keine gültige Benutzerliste geliefert.');
    const old=new Map(db.partners.filter(p=>p.reonicId).map(p=>[p.reonicId,p]));
    const next=data.users.filter(u=>typeof u.reonic_id==='string').map((u,i)=>{
      const prior=old.get(u.reonic_id);
      return {...(prior||{}),id:prior?.id||(1000000+i),reonicId:u.reonic_id,name:String(u.name||'Unbenannter Benutzer'),email:String(u.email||''),reonic:'Reonic',team:u.is_external?'Extern':'Intern',region:prior?.region||'',zip:prior?.zip||'',city:prior?.city||'',hidden:prior?.hidden??true};
    });
    if(!next.length)throw new Error('Keine Benutzer zurückgegeben; die Demo-Daten bleiben unverändert.');
    if(!confirm(next.length+' Reonic-Benutzer übernehmen? Bestehende Demo-Vertriebspartner werden ersetzt. Alle neuen Benutzer sind zunächst ausgeblendet.')){el.textContent='Import abgebrochen.';return}
    db.partners=next;partnerView='hidden';save();renderPartners();el.textContent=next.length+' Reonic-Benutzer geladen. Unter „Ausgeblendete Benutzer“ kannst du echte Vertriebspartner aktivieren und PLZ eintragen. Die Auswahl ist bislang nur lokal gespeichert.';
  }catch(e){el.textContent='Abruf fehlgeschlagen: '+e.message+'. Prüfe Anmeldung, Function-Logs und den veröffentlichten Funktionscode.'}
}
async function gbLogout(){if(gbClient)await gbClient.auth.signOut();gbClient=null;gbSession=null;document.getElementById('gb-cloud').style.display='none';gbShowConnection();gbStatus('Abgemeldet.')}
(function gbInit(){try{const c=JSON.parse(localStorage.getItem('gb-supabase-public-config')||'null');if(c){document.getElementById('gb-url').value=c.url||'';document.getElementById('gb-public').value=c.key||'';if(window.supabase?.createClient){gbClient=window.supabase.createClient(c.url,c.key,{auth:{detectSessionInUrl:true}});gbAttachRecovery(gbClient);gbClient.auth.getUser().then(async ({data,error})=>{if(!error&&data.user){const {data:admin}=await gbClient.from('app_admins').select('user_id').eq('user_id',data.user.id).maybeSingle();if(admin&&!gbRecoveryLinkPresent())gbConnected(data.user.email||'Administrator')}})}}}catch(e){console.warn('Supabase-Konfiguration:',e.message)}})();
</script><script>
// Recovery bootstrap for first-time users without a previously saved Supabase config.
async function gbRecoveryConnect(){
 const url=document.getElementById('gb-url').value.trim().replace(/\/$/,''),key=document.getElementById('gb-public').value.trim();
 if(!/^https:\/\/[a-z0-9-]+\.supabase\.co$/i.test(url)||!key){gbStatus('Bitte zuerst Supabase-Projekt-URL und Publishable Key eintragen.');return}
 if(!window.supabase?.createClient){gbStatus('Supabase konnte nicht geladen werden. Bitte Internetverbindung prüfen.');return}
 try{
  gbClient=window.supabase.createClient(url,key,{auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:true}});
  localStorage.setItem('gb-supabase-public-config',JSON.stringify({url,key}));
  gbAttachRecovery(gbClient);
  const {data,error}=await gbClient.auth.getSession();
  if(error)throw error;
  if(data?.session){gbRecoveryShow();gbStatus('Jetzt neues Passwort eingeben und speichern.');}
  else gbStatus('Kein gültiger Reset-Link erkannt. Bitte einen neuen Link aus Supabase anfordern und auf dieser Website öffnen.');
 }catch(e){gbStatus('Verbindung fehlgeschlagen: '+e.message)}
}
(function(){
 if(!gbRecoveryLinkPresent())return;
 const btn=document.getElementById('gb-reset-connect');btn.style.display='block';
 document.getElementById('gb-connect').style.display='flex';
 document.getElementById('gb-login-actions').style.display='none';
 document.getElementById('gb-recovery-box').style.display='block';
 gbStatus('Passwort zurücksetzen: Falls URL und Key leer sind, trage sie oben ein und klicke „Passwort-Link aktivieren“.');
})();
