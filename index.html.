let db;try{db=JSON.parse(localStorage.getItem('lcc-demo-v11'))||structuredClone(seed)}catch{db=structuredClone(seed)};function purgeOldAssignedLeads(){const cutoff=Date.now()-84*24*60*60*1000;const before=db.leads.length;db.leads=db.leads.filter(l=>!l.partnerId||!l.assignedAt||new Date(l.assignedAt).getTime()>=cutoff);return before-db.leads.length}purgeOldAssignedLeads();try{localStorage.setItem('lcc-demo-v11',JSON.stringify(db))}catch{};function save(){purgeOldAssignedLeads();try{localStorage.setItem('lcc-demo-v11',JSON.stringify(db))}catch{}renderAll()};function escapeHTML(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))};function partner(id){return db.partners.find(p=>p.id===id)};function mondayStart(d=new Date()){const x=new Date(d);x.setHours(0,0,0,0);x.setDate(x.getDate()-(x.getDay()+6)%7);return x}
function assignedForOrder(o){return db.leads.filter(l=>l.partnerId===o.partnerId&&l.orderId===o.id)}
function receivedForOrder(o){const all=assignedForOrder(o);return o.type==='once'?all.length:all.filter(l=>l.assignedAt&&new Date(l.assignedAt)>=mondayStart()).length}
function countAssigned(id){return db.leads.filter(l=>l.partnerId===id).length}
function weeklyReceived(id){return db.leads.filter(l=>l.partnerId===id&&l.assignedAt&&new Date(l.assignedAt)>=mondayStart()).length}
function orderRemaining(o){return Math.max(0,o.quantity-receivedForOrder(o))}
function chooseOrder(partnerId,zip){return db.orders.filter(o=>o.partnerId===partnerId&&orderRemaining(o)>0&&matchesRegion(zip,o.region)).sort((a,b)=>(a.type==='once'?0:1)-(b.type==='once'?0:1))[0]}
function toggleRegionMode(){const radius=document.getElementById('order-region-mode').value==='radius';document.getElementById('order-radius-fields').style.display=radius?'block':'none';document.getElementById('order-zips-fields').style.display=radius?'none':'block'}
function orderRegionLabel(o){return o.regionMode==='radius'?`Umkreis ${o.radiusKm} km um ${o.centerZip}`:o.region}
function matchesOrderRegion(zip,o){if(o.regionMode==='radius'){const a=zipCoordinates[String(zip)],b=zipCoordinates[String(o.centerZip)];return !!(a&&b&&haversine(a[0],a[1],b[0],b[1])<=Number(o.radiusKm))}return matchesRegion(zip,o.region)}
function matchesRegion(zip,region){return String(region||'').split(/[,;]+/).some(x=>{let t=x.trim().replace(/\\s/g,'');return t==='*'||(t.endsWith('*')?zip.startsWith(t.slice(0,-1)):zip===t)})}
