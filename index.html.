function renderAll(){renderHistory();document.getElementById('stat-leads').textContent=db.leads.filter(l=>!l.partnerId).length;document.getElementById('stat-orders').textContent=db.orders.filter(o=>orderRemaining(o)>0).length;document.getElementById('stat-assigned').textContent=db.leads.filter(l=>l.partnerId&&l.assignedAt&&new Date(l.assignedAt)>=mondayStart()).length;document.getElementById('stat-partners').textContent=activePartners().length;document.getElementById('dashboard-leads').innerHTML=db.leads.filter(l=>!l.partnerId).slice(0,5).map(l=>`<tr><td><strong>${escapeHTML(l.name)}</strong></td><td>${zipButton(l)}</td><td>${escapeHTML(l.source)}</td></tr>`).join('')||'<tr><td colspan="3" class="empty">Keine offenen Leads</td></tr>';document.getElementById('dashboard-orders').innerHTML=db.orders.slice(0,4).map(o=>{let remaining=orderRemaining(o);return `<div class="order"><strong>${escapeHTML(partner(o.partnerId)?.name||'Unbekannt')}</strong><p>${o.type==='once'?'Einmalig':'Wöchentlich'} · Gebiet: ${escapeHTML(orderRegionLabel(o))} · ${remaining} von ${o.quantity} offen</p><div class="progress"><i style="width:${Math.min(100,100*(o.quantity-remaining)/o.quantity)}%"></i></div></div>`}).join('')||'<div class="empty">Keine Bestellungen</div>';renderSuppliers();renderLeads();renderOrders();renderPartners();if(document.getElementById('partner-map').classList.contains('active'))renderPartnerMap();document.getElementById('order-partner').innerHTML='<option value="">Kein Vertriebspartner – freie Gebietsbestellung</option>'+activePartners().map(p=>`<option value="${p.id}">${escapeHTML(p.name)}</option>`).join('')}
let leadMode='list',focusLeadId=null;
function focusOpenLeads(){const q=(document.getElementById('lead-search')?.value||'').toLowerCase();return db.leads.filter(l=>!l.partnerId&&(l.name.toLowerCase().includes(q)||l.zip.includes(q)||l.source.toLowerCase().includes(q)))}
function setLeadMode(mode){leadMode=mode;document.getElementById('lead-mode-list').classList.toggle('active',mode==='list');document.getElementById('lead-mode-focus').classList.toggle('active',mode==='focus');document.getElementById('lead-list-area').style.display=mode==='list'?'block':'none';document.getElementById('lead-focus').style.display=mode==='focus'?'block':'none';if(mode==='focus'){document.getElementById('lead-filter').value='all';renderLeads();renderFocusLead()}else renderLeads()}
let focusRouteRequest=0;
function renderFocusLead(){if(leadMode!=='focus')return;const leads=focusOpenLeads(),el=document.getElementById('lead-focus');if(!leads.length){focusLeadId=null;el.innerHTML='<div class="lead-focus-card lead-focus-empty"><h2>Alle offenen Leads erledigt ✓</h2><p>Es sind keine weiteren offenen Leads vorhanden.</p></div>';return}let idx=leads.findIndex(l=>l.id===focusLeadId);if(idx<0){idx=0;focusLeadId=leads[0].id}const l=leads[idx];el.innerHTML=`<div class="lead-focus-card"><div class="lead-focus-top"><span class="lead-focus-count">Lead ${idx+1} von ${leads.length}</span><span class="pill orange">Offen</span></div><div class="lead-focus-name">${escapeHTML(l.name)}</div><div class="lead-focus-details"><span>⌖ ${escapeHTML([l.street||l.address||"",[l.zip,l.city].filter(Boolean).join(" ")].filter(Boolean).join(", "))}</span><span>◈ ${escapeHTML(l.source)}</span></div><div class="lead-focus-actions"><button class="btn secondary" onclick="stepFocus(-1)" ${idx===0?'disabled':''}>← Zurück</button><button class="btn secondary" onclick="stepFocus(1)" ${idx===leads.length-1?'disabled':''}>Weiter →</button></div><div class="focus-suggestions-title"><h3>Vertriebspartner direkt zuweisen</h3><small>Die zehn Vorschläge stehen hier direkt unter dem Lead.</small></div><div id="focus-suggestions" class="focus-suggestions"><p>Vorschläge werden geladen …</p></div><div class="focus-other"><label for="focus-partner-search">Anderen Vertriebspartner suchen und auswählen</label><input id="focus-partner-search" type="search" placeholder="Name oder PLZ suchen, z. B. Uwe Peters …" oninput="filterFocusPartners()" autocomplete="off" style="width:100%;margin:8px 0 10px"><div class="focus-other-row"><select id="focus-other-partner" onchange="focusOtherRoute()"><option value="">Vertriebspartner wählen …</option>${activePartners().slice().sort((a,b)=>a.name.localeCompare(b.name,'de')).map(p=>`<option value="${p.id}">${escapeHTML(p.name)} · ${escapeHTML(p.zip||p.city||'')}</option>`).join('')}</select><button class="btn" onclick="assignFocusOther()">Zuweisen</button></div><small id="focus-other-route">Auch ohne offene Bestellung möglich.</small></div></div>`;loadFocusSuggestions(l.id)}
async function loadFocusSuggestions(id){const l=db.leads.find(x=>x.id===id),req=++focusRouteRequest;if(!l)return;let ranked=activePartners().map(p=>({...p,orders:db.orders.filter(o=>o.partnerId===p.id&&matchesOrderRegion(l.zip,o)&&orderRemaining(o)>0),weekly:weeklyReceived(p.id),route:null}));paintFocusSuggestions(ranked.slice(0,10),id);await Promise.all(ranked.map(async p=>{p.route=await routeFromTo(l,p)}));if(req!==focusRouteRequest||focusLeadId!==id||leadMode!=='focus')return;ranked.sort((a,b)=>Number(!!b.orders.length)-Number(!!a.orders.length)||(a.route?.min??Infinity)-(b.route?.min??Infinity));paintFocusSuggestions(ranked.slice(0,10),id)}
function paintFocusSuggestions(ranked,id){const el=document.getElementById('focus-suggestions');if(!el||focusLeadId!==id)return;el.innerHTML=ranked.map((p,i)=>{const o=p.orders[0],route=p.route?`${p.route.km.toFixed(1).replace('.',',')} km · ${p.route.min} Min.`:'Fahrzeit nicht verfügbar';return `<article class="focus-partner-card"><div class="focus-partner-info"><strong><span class="focus-rank">${i+1}</span> ${escapeHTML(p.name)}</strong><small>${escapeHTML(p.zip||'')} ${escapeHTML(p.city||'')} · 🚗 ${route}</small><small>${o?(o.type==='once'?'Einmalig':'Wöchentlich')+' · '+orderRemaining(o)+' offen':'Ohne offene Bestellung'} · Diese Woche: ${p.weekly}</small></div><button class="btn focus-partner-assign" onclick="assignFocusPartner(${id},${p.id})">Zuweisen ↗</button></article>`}).join('')||'<p>Keine Vertriebspartner hinterlegt.</p>'}
function assignFocusPartner(leadId,partnerId){const l=db.leads.find(x=>x.id===leadId),p=partner(partnerId);if(!l||!p||!isPartnerActive(p)||l.partnerId)return;const remaining=focusOpenLeads(),idx=remaining.findIndex(x=>x.id===leadId);assignToOrder(l,partnerId);focusRouteRequest++;save();const next=focusOpenLeads();focusLeadId=next[Math.min(idx,next.length-1)]?.id||null;const card=document.querySelector('.lead-focus-card');if(card){card.innerHTML='<div class="focus-success"><span class="focus-success-check">✓</span><strong>Zugewiesen!</strong><small>'+escapeHTML(l.name)+' → '+escapeHTML(p.name)+'</small></div>'}document.getElementById('stat-leads').textContent=focusOpenLeads().length;setTimeout(()=>{renderAll();if(leadMode==='focus')renderFocusLead()},650);toast('✓ Lead zugewiesen – Reonic bleibt unverändert.')}
function filterFocusPartners(){const q=(document.getElementById('focus-partner-search')?.value||'').trim().toLocaleLowerCase('de');const sel=document.getElementById('focus-other-partner');if(!sel)return;const chosen=sel.value;sel.innerHTML='<option value="">Vertriebspartner wählen …</option>'+activePartners().filter(p=>[p.name,p.zip,p.city].some(v=>String(v||'').toLocaleLowerCase('de').includes(q))).sort((a,b)=>a.name.localeCompare(b.name,'de')).map(p=>`<option value="${p.id}">${escapeHTML(p.name)} · ${escapeHTML(p.zip||p.city||'')}</option>`).join('');if([...sel.options].some(o=>o.value===chosen))sel.value=chosen;else document.getElementById('focus-other-route').textContent='Auch ohne offene Bestellung möglich.'}
function assignFocusOther(){const id=Number(document.getElementById('focus-other-partner')?.value);if(!id)return toast('Bitte Vertriebspartner auswählen.');assignFocusPartner(focusLeadId,id)}
async function focusOtherRoute(){const id=Number(document.getElementById('focus-other-partner')?.value),l=db.leads.find(x=>x.id===focusLeadId),p=partner(id),out=document.getElementById('focus-other-route');if(!out)return;if(!p||!l){out.textContent='Auch ohne offene Bestellung möglich.';return}out.textContent='Berechne Fahrzeit …';const leadId=l.id,r=await routeFromTo(l,p);if(focusLeadId!==leadId||Number(document.getElementById('focus-other-partner')?.value)!==id)return;out.textContent=r?`${r.km.toFixed(1).replace('.',',')} km · ${r.min} Min. Fahrzeit`:'Fahrzeit nicht verfügbar – Zuweisung trotzdem möglich'}
function stepFocus(delta){const leads=focusOpenLeads(),idx=leads.findIndex(l=>l.id===focusLeadId);if(!leads.length)return;focusLeadId=leads[Math.max(0,Math.min(leads.length-1,idx+delta))].id;renderFocusLead()}
